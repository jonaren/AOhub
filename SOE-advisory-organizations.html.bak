    <script>
           // Configuration for award requirements
        const AWARD_REQUIREMENTS = {
            silver: {
                needed: 9,  // Need 9 out of total Silver items
                total: 10   // Expected total Silver items (updated dynamically)
            },
            gold: {
                silverNeeded: 9,  // Need 9 Silver items
                goldNeeded: 4,    // Need 3 Gold items  
                silverTotal: 10,  // Expected total Silver items (updated dynamically)
                goldTotal: 5      // Expected total Gold items (updated dynamically)
            }
        };

        // Google Sheets configuration
        const GOOGLE_SHEETS_CONFIG = {
            spreadsheetId: '1WLS8MMptA9XXZZA5WFxkaIAXQSf86k999gIV00hHOKc', // Extract from your original URL
            apiKey: 'AIzaSyAPM5xbd3Lxk6dRx_5Kb9U2fUzdUEiwUzw', // You'll need to add this
            range: 'Sheet1!A:Z' // Adjust range as needed
        };
        
        // Category configurations
        const categoryConfig = {
            'Gold': {
                icon: 'fas fa-crown',
                iconClass: 'gold-icon',
                title: 'Gold Standards of Excellence',
                intro: 'You will need to complete 3/4 of the following requirements in addition to 9/10 of Silver requirements to receive a Gold Standards of Excellence Award',
                printIntro: 'The following are the Gold Standards of Excellence requirements you have selected as part of your application.'
            },
            'Silver': {
                icon: 'fas fa-medal',
                iconClass: 'silver-icon',
                title: 'Silver Standards of Excellence',
                intro: 'You will need to complete the first mandatory two requirements and 7/8 of the following for a total of 9/10 to receive a Silver Standards of Excellence Award',
                printIntro: 'The following are the Silver Standards of Excellence requirements you have selected as part of your application.'
            }
        };

        // Fetch data from Google Sheets API
        async function fetchSheetsData() {
            const { spreadsheetId, apiKey, range } = GOOGLE_SHEETS_CONFIG;
            const url = `https://sheets.googleapis.com/v4/spreadsheets/${spreadsheetId}/values/${range}?key=${apiKey}`;
            
            try {
                const response = await fetch(url);
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const data = await response.json();
                
                if (!data.values || data.values.length === 0) {
                    throw new Error('No data found in spreadsheet');
                }
                
                return data.values;
            } catch (error) {
                console.error('Error fetching Google Sheets data:', error);
                throw error;
            }
        }

        // Convert Google Sheets array data to objects
        function convertSheetsDataToObjects(sheetsData) {
            if (!sheetsData || sheetsData.length === 0) {
                return [];
            }

            const headers = sheetsData[0].map(header => header.trim());
            const data = [];

            for (let i = 1; i < sheetsData.length; i++) {
                const row = sheetsData[i];
                if (row && row.length > 0) {
                    const rowData = {};
                    headers.forEach((header, index) => {
                        rowData[header] = (row[index] || '').toString().trim();
                    });
                    
                    // Only add rows that have essential data
                    if (rowData.Description || rowData.step_ID) {
                        data.push(rowData);
                    }
                }
            }

            return data;
        }

        // Create resource links
        function createResourceLinks(row) {
            const buttons = [];
            
            // Look for resourcelink1 through resourcelink7
            for (let i = 1; i <= 7; i++) {
                const url = row[`resourcelink${i}`];
                const label = row[`resourcelabel${i}`];
                
                if (url && url.trim()) {
                    // Only show button if there's a label, or use a simple default
                    const buttonText = (label && label.trim()) ? label.trim() : `Resource ${i}`;
                    buttons.push(`<a href="${url.trim()}" class="btn btn-outline-primary btn-sm resource-button" target="_blank">${buttonText}</a>`);
                }
            }

            return buttons.join('');
        }

        // Create HTML for items
        function createItemHTML(item) {
            const category = item.Category || 'Silver';
            const config = categoryConfig[category] || categoryConfig['Silver'];
            const description = item.Description || '';
            const resources = createResourceLinks(item);
            const stepId = item.step_ID;
            const alertText = item.Alert || '';
            const hasAlert = alertText && alertText.trim() !== '';
            const collapseId = `alert-${stepId}`;

            return `
                <div class="col-12 col-md-6 mb-3">
                    <div class="item-card h-100" data-step-id="${stepId}" data-category="${category}">
                        <input type="checkbox" class="item-checkbox" data-step-id="${stepId}" data-category="${category}">
                        <i class="${config.icon} category-icon ${config.iconClass}"></i>
                        <div class="item-content">
                            ${hasAlert ? `
                            <div class="alert-section mb-3">
                                <i class="fas fa-exclamation-triangle alert-icon"></i>${alertText}
                            </div>
                            ` : ''}
                            <div class="description">
                                ${description}
                            </div>
                            ${resources ? `
                            <div class="resources-section">
                                <strong>Resources:</strong><br>
                                ${resources}
                            </div>
                            ` : ''}
                            
                        </div>
                    </div>
                </div>
            `;
        }

        // Group items by category
        function groupByCategory(data) {
            const grouped = {};
            data.forEach(item => {
                const category = item.Category || 'Silver';
                if (!grouped[category]) {
                    grouped[category] = [];
                }
                grouped[category].push(item);
            });
            return grouped;
        }

        // Render content
        function renderContent(data) {
            const grouped = groupByCategory(data);
            let html = '';

            // Add progress tracker
            html += createProgressTracker();

            // Render categories in order of preference
            ['Silver', 'Gold', 'Test'].forEach(categoryKey => {
                if (grouped[categoryKey] && grouped[categoryKey].length > 0) {
                    const config = categoryConfig[categoryKey];
                    html += `
                        <div class="category-section">
                            <h2><i class="${config.icon} ${config.iconClass} me-2"></i>${config.title}</h2>
                            <p class="lead screen-only">${config.intro}</p>
                            <p class="print-only">${config.printIntro}</p>
                            <div class="row">
                                ${grouped[categoryKey].map(item => createItemHTML(item)).join('')}
                            </div>
                        </div>
                    `;
                }
            });

            document.getElementById('content').innerHTML = html;
            document.getElementById('loading').style.display = 'none';
            document.getElementById('content').style.display = 'block';

            // Initialize progress tracking
            initializeProgressTracking();
        }

        // Fetch and process data
        async function loadData() {
            try {
                // Show loading state
                document.getElementById('loading').style.display = 'block';
                document.getElementById('content').style.display = 'none';

                // Fetch data from Google Sheets
                const sheetsData = await fetchSheetsData();
                
                // Convert to objects
                const data = convertSheetsDataToObjects(sheetsData);
                
                // Log the parsed data for debugging
                console.log('Parsed data:', data);
                console.log('Available columns:', data.length > 0 ? Object.keys(data[0]) : 'No data');
                
                // Debug: Log first row to check label values
                if (data.length > 0) {
                    console.log('First row sample:', data[0]);
                    console.log('Resource labels check:');
                    for (let i = 1; i <= 7; i++) {
                        const link = data[0][`resourcelink${i}`];
                        const label = data[0][`resourcelabel${i}`];
                        if (link) {
                            console.log(`Resource ${i}: Link="${link}", Label="${label}"`);
                        }
                    }
                    
                    // Debug: Check category values
                    console.log('Categories found:', [...new Set(data.map(item => item.Category))]);
                    console.log('Silver items:', data.filter(item => item.Category === 'Silver').length);
                    console.log('Gold items:', data.filter(item => item.Category === 'Gold').length);
                }
                
                // Debug: Check if groupByCategory is working
                const grouped = groupByCategory(data);
                console.log('Grouped data:', grouped);
                
                renderContent(data);
            } catch (error) {
                console.error('Error loading data:', error);
                document.getElementById('loading').innerHTML = `
                    <div class="alert alert-danger">
                        <h4>Error Loading Data</h4>
                        <p>There was an error loading the spreadsheet data: ${error.message}</p>
                        <p>Please check the console for more details and verify your API configuration.</p>
                        <small class="text-muted">
                            Common issues:
                            <ul>
                                <li>Invalid API key</li>
                                <li>Incorrect spreadsheet ID</li>
                                <li>Spreadsheet is not publicly accessible</li>
                                <li>API quota exceeded</li>
                            </ul>
                        </small>
                    </div>
                `;
            }
        }

        // Load data when page loads
        document.addEventListener('DOMContentLoaded', loadData);

        // Create progress tracker HTML
        function createProgressTracker() {
            return `
                <div class="progress-tracker">
                    <button class="progress-toggle" id="progress-toggle">
                        <i class="fas fa-trophy"></i>
                     Choose your path to your award
                        <i class="fas fa-chevron-down toggle-icon" id="toggle-icon"></i>
                    </button>
                    <div class="progress-content" id="progress-content">
                    
                        
                        <div class="award-progress">
                            <div class="award-title">
                                <i class="fas fa-medal silver-icon"></i>
                                Silver Award
                                <span class="award-badge badge-not-achieved" id="silver-badge">Not Achieved</span>

                            </div>
                                                                                    

                            <div class="progress-bar-container">
                                <div class="progress-bar-fill silver-progress" id="silver-progress" style="width: 0%;">
                                    <span id="silver-text">0/10</span>
                                </div>
                            </div>
                           
                        </div>

                        <div class="award-progress">
                            <div class="award-title">
                                <i class="fas fa-crown gold-icon"></i>
                                Gold Award
                                <span class="award-badge badge-not-achieved" id="gold-badge">Not Achieved</span>
                            </div>
                            <div class="progress-bar-container">
                                <div class="progress-bar-fill gold-progress" id="gold-progress" style="width: 0%;">
                                    <span id="gold-text">0/13</span>
                                </div>
                            </div>
                           
                        </div>

                        <button class="print-btn" onclick="printSelected()">
                            <i class="fas fa-print"></i> Print My Selected Standards
                        </button>
                    </div>
                </div>
            `;
        }

        // Initialize progress tracking
        function initializeProgressTracking() {
            // Add toggle functionality
            const toggleButton = document.getElementById('progress-toggle');
            const progressContent = document.getElementById('progress-content');
            const toggleIcon = document.getElementById('toggle-icon');
            
            toggleButton.addEventListener('click', () => {
                const isVisible = progressContent.classList.contains('show');
                const contentDiv = document.getElementById('content');
                
                if (isVisible) {
                    progressContent.classList.remove('show');
                    toggleIcon.classList.remove('rotated');
                    contentDiv.classList.remove('progress-active');
                    toggleButton.innerHTML = `
                        <i class="fas fa-trophy"></i>
                        Track Your Accreditation Progress
                        <i class="fas fa-chevron-down toggle-icon" id="toggle-icon"></i>
                    `;
                } else {
                    progressContent.classList.add('show');
                    toggleIcon.classList.add('rotated');
                    contentDiv.classList.add('progress-active');
                    toggleButton.innerHTML = `
                        <i class="fas fa-trophy"></i>
                        Hide Progress Tracker
                        <i class="fas fa-chevron-up toggle-icon rotated" id="toggle-icon"></i>
                    `;
                }
            });
            
            // Load saved progress from localStorage
            const savedProgress = JSON.parse(localStorage.getItem('accreditationProgress') || '{}');
            
            // Apply saved checkboxes
            Object.keys(savedProgress).forEach(stepId => {
                const checkbox = document.querySelector(`input[data-step-id="${stepId}"]`);
                const card = document.querySelector(`div[data-step-id="${stepId}"]`);
                if (checkbox && savedProgress[stepId]) {
                    checkbox.checked = true;
                    card.classList.add('completed');
                }
            });

            // Add event listeners to checkboxes
            document.querySelectorAll('.item-checkbox').forEach(checkbox => {
                checkbox.addEventListener('change', handleCheckboxChange);
            });

            // Initial progress update
            updateProgress();
        }

        // Handle checkbox changes
        function handleCheckboxChange(event) {
            const checkbox = event.target;
            const stepId = checkbox.dataset.stepId;
            const card = document.querySelector(`div[data-step-id="${stepId}"]`);
            
            // Toggle card appearance
            if (checkbox.checked) {
                card.classList.add('completed');
            } else {
                card.classList.remove('completed');
            }

            // Save progress
            saveProgress();
            
            // Update progress bars
            updateProgress();
        }

        // Save progress to localStorage
        function saveProgress() {
            const progress = {};
            document.querySelectorAll('.item-checkbox').forEach(checkbox => {
                progress[checkbox.dataset.stepId] = checkbox.checked;
            });
            localStorage.setItem('accreditationProgress', JSON.stringify(progress));
        }

        // Update progress bars and badges
        function updateProgress() {
            const silverChecked = document.querySelectorAll('input[data-category="Silver"]:checked').length;
            const goldChecked = document.querySelectorAll('input[data-category="Gold"]:checked').length;
            const silverTotal = document.querySelectorAll('input[data-category="Silver"]').length;
            const goldTotal = document.querySelectorAll('input[data-category="Gold"]').length;

            // Update dynamic totals
            AWARD_REQUIREMENTS.silver.total = silverTotal;
            AWARD_REQUIREMENTS.gold.silverTotal = silverTotal;
            AWARD_REQUIREMENTS.gold.goldTotal = goldTotal;

            // Update Silver progress
            const silverProgress = document.getElementById('silver-progress');
            const silverText = document.getElementById('silver-text');
            const silverBadge = document.getElementById('silver-badge');
            
            const silverPercentage = (silverChecked / silverTotal) * 100;
            silverProgress.style.width = `${silverPercentage}%`;
            silverText.textContent = `${silverChecked}/${silverTotal}`;

            // Check Silver achievement
            const silverAchieved = silverChecked >= AWARD_REQUIREMENTS.silver.needed;
            if (silverAchieved) {
                silverBadge.textContent = '🎉 Achieved!';
                silverBadge.className = 'award-badge badge-achieved badge-silver';
                if (!silverBadge.classList.contains('celebration')) {
                    silverBadge.classList.add('celebration');
                    setTimeout(() => silverBadge.classList.remove('celebration'), 1000);
                }
            } else {
                silverBadge.textContent = `${AWARD_REQUIREMENTS.silver.needed - silverChecked} more needed`;
                silverBadge.className = 'award-badge badge-not-achieved';
            }

            // Update Gold progress (requires Silver + Gold requirements)
            const goldProgress = document.getElementById('gold-progress');
            const goldText = document.getElementById('gold-text');
            const goldBadge = document.getElementById('gold-badge');
            
            const totalCompleted = silverChecked + goldChecked;
            const totalRequirements = silverTotal + goldTotal;
            const goldPercentage = (totalCompleted / totalRequirements) * 100;
            goldProgress.style.width = `${goldPercentage}%`;
            goldText.textContent = `${totalCompleted}/${totalRequirements}`;

            // Check Gold achievement
            const goldAchieved = silverChecked >= AWARD_REQUIREMENTS.gold.silverNeeded && goldChecked >= AWARD_REQUIREMENTS.gold.goldNeeded;
            if (goldAchieved) {
                goldBadge.textContent = '🏆 Achieved!';
                goldBadge.className = 'award-badge badge-achieved badge-gold';
                if (!goldBadge.classList.contains('celebration')) {
                    goldBadge.classList.add('celebration');
                    setTimeout(() => goldBadge.classList.remove('celebration'), 1000);
                }
            } else {
                const silverNeeded = Math.max(0, AWARD_REQUIREMENTS.gold.silverNeeded - silverChecked);
                const goldNeeded = Math.max(0, AWARD_REQUIREMENTS.gold.goldNeeded - goldChecked);
                let badgeText = '';
                if (silverNeeded > 0 && goldNeeded > 0) {
                    badgeText = `${silverNeeded} Silver + ${goldNeeded} Gold needed`;
                } else if (silverNeeded > 0) {
                    badgeText = `${silverNeeded} more Silver needed`;
                } else if (goldNeeded > 0) {
                    badgeText = `${goldNeeded} more Gold needed`;
                }
                goldBadge.textContent = badgeText;
                goldBadge.className = 'award-badge badge-not-achieved';
            }
        }

        // Build the print header award status badges
        function updatePrintHeader() {
            const silverChecked = document.querySelectorAll('input[data-category="Silver"]:checked').length;
            const goldChecked  = document.querySelectorAll('input[data-category="Gold"]:checked').length;

            const silverAchieved = silverChecked >= AWARD_REQUIREMENTS.silver.needed;
            const goldAchieved   = silverChecked >= AWARD_REQUIREMENTS.gold.silverNeeded &&
                                   goldChecked   >= AWARD_REQUIREMENTS.gold.goldNeeded;

            // Date
            document.getElementById('print-date').textContent =
                'Generated: ' + new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

            // Award badges
            const awardsEl = document.getElementById('print-award-status');
            let badgesHTML = '';

            if (goldAchieved) {
                badgesHTML += `<span class="ph-badge ph-badge-gold-achieved">🏆 Gold Award — Achieved</span>`;
                badgesHTML += `<span class="ph-badge ph-badge-silver-achieved">🎉 Silver Award — Achieved</span>`;
            } else if (silverAchieved) {
                badgesHTML += `<span class="ph-badge ph-badge-silver-achieved">🎉 Silver Award — Achieved</span>`;
                const goldSilverNeeded = Math.max(0, AWARD_REQUIREMENTS.gold.silverNeeded - silverChecked);
                const goldGoldNeeded   = Math.max(0, AWARD_REQUIREMENTS.gold.goldNeeded   - goldChecked);
                let gapText = '';
                if (goldSilverNeeded > 0 && goldGoldNeeded > 0) {
                    gapText = `${goldSilverNeeded} more Silver + ${goldGoldNeeded} more Gold needed for Gold`;
                } else if (goldGoldNeeded > 0) {
                    gapText = `${goldGoldNeeded} more Gold needed for Gold Award`;
                }
                if (gapText) {
                    badgesHTML += `<span class="ph-badge ph-badge-not-achieved">${gapText}</span>`;
                }
            } else {
                const silverNeeded = Math.max(0, AWARD_REQUIREMENTS.silver.needed - silverChecked);
                badgesHTML += `<span class="ph-badge ph-badge-not-achieved">${silverNeeded} more Silver item${silverNeeded !== 1 ? 's' : ''} needed for Silver Award</span>`;
            }

            awardsEl.innerHTML = badgesHTML;
        }

        // Print only the selected (checked) cards
        function printSelected() {
            const selectedCards = document.querySelectorAll('.item-card.completed');
            if (selectedCards.length === 0) {
                alert('Please check at least one item before printing.');
                return;
            }

            // Mark column wrappers that contain no selected card so CSS can hide them
            document.querySelectorAll('.col-12.col-md-6').forEach(col => {
                const card = col.querySelector('.item-card');
                if (card && card.classList.contains('completed')) {
                    col.classList.remove('print-hidden');
                } else {
                    col.classList.add('print-hidden');
                }
            });

            // Also hide category-section headings if ALL cards in them are unselected
            document.querySelectorAll('.category-section').forEach(section => {
                const visibleCards = section.querySelectorAll('.item-card.completed');
                if (visibleCards.length === 0) {
                    section.classList.add('print-hidden');
                } else {
                    section.classList.remove('print-hidden');
                }
            });

            updatePrintHeader();
            window.print();
        }

        // Expose functions for manual testing
        window.spreadsheetIntegration = {
            loadData,
            fetchSheetsData,
            convertSheetsDataToObjects,
            renderContent
        };
    </script>
    </div>

<?php include 'footer.php'; ?>